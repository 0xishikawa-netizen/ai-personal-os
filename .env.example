# コピーして .env にリネームし、値を埋めてください。
#
# 【推奨・既定】DBeaver と同じ「ホスト上の Postgres」（例: localhost:5432）。
# docker compose の api は host.docker.internal でホストに届く（chat / quiz / Flyway すべてこの DB）。
DB_URL=jdbc:postgresql://host.docker.internal:5432/postgres
DB_USER=postgres
DB_PASSWORD=postgres
#
# --- Supabase（Render 本番の例）---
# ダッシュボードの Database → Connection string → JDBC 相当を組み立てる。
# sslmode=require を付ける。ホストは often db.xxxxx.supabase.co:5432
# DB_URL=jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres?sslmode=require
# DB_USER=postgres
# DB_PASSWORD=（Supabase のパスワード）
#
# Pooler（6543）を使う場合は Supabase のドキュメントに従い、JDBC URL を調整する。
#
# 同梱 Postgres を使う場合（ポート 5433）:
#   docker compose --profile bundled-db up -d
#   DB_URL=jdbc:postgresql://db:5432/postgres
#
# ./gradlew bootRun / IDE からホスト直起動するときは localhost でよい:
#   DB_URL=jdbc:postgresql://localhost:5432/postgres
#
# Kairos が主に使うテーブル（DBeaver で整理するときの目安）:
#   chat_message, flyway_schema_history, quiz_section, quiz_chapter, quiz_question,
#   quiz_choice, quiz_tag, quiz_question_tag, quiz_answer_log

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# ブラウザが API を直叩きするときのみ。Vercel プロキシのみなら未設定でよい。
# KAIROS_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-app.vercel.app
