# コピーして .env にリネームし、値を埋めてください。
# docker compose の api コンテナ用: ホスト名は必ず「db」（compose のサービス名）。
# compose.yml 側でも DB_URL を db に固定している。接続できないときは次を試す:
#   docker compose down && docker compose up -d --build --force-recreate
# compose は DB をホストの 5433 にマッピング（5432 競合回避）。ホストから psql する場合は localhost:5433。
# ホストで ./gradlew bootRun や IDE から起動する場合: 「localhost」にする（同じ .env を IDE が読むと db は解決できません）。

DB_URL=jdbc:postgresql://db:5432/postgres
DB_USER=postgres
DB_PASSWORD=postgres

# ホストから API だけ起動するときの例:
# DB_URL=jdbc:postgresql://localhost:5432/postgres

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
